# FlawCheck env contract — committed template. Copy to .env.local and fill in real values.
# NEBIUS_MODEL_* IDs below are the research-verified recommendations from
# .planning/phases/01-platform-spike/01-RESEARCH.md (verified 2026-09-26).
# Model IDs deprecate: re-verify against the live catalog (`npm run catalog`) and
# the official model catalog before trusting these on any deprecation notice.
NEBIUS_API_KEY=your-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_EXTRACTION=nvidia/Nemotron-3_5-Lightning

# LLM kill-switch (DEMO-02 demo mode): set to 1 or true to run the
# deterministic fallback engine with zero Nebius calls — the demo scenario
# then runs entirely from the committed fixture with no network dependency.
FLAWCHECK_DISABLE_LLM=

# Tavily (optional, PLAT-03): post-acceptance code-edition/errata lookup on
# the report screen. Absent key degrades silently — no block, no error.
TAVILY_API_KEY=
